# MySQL connection
# You can use DATABASE_URL with an Aiven-style URI, or the split variables below.
DATABASE_URL=mysql://USER:PASSWORD@HOST:PORT/DB_NAME?ssl-mode=REQUIRED
DB_HOST=localhost
DB_PORT=3306
DB_NAME=zahlx
DB_USER=root
DB_PASSWORD=your_password_here
DB_SSL_MODE=REQUIRED
# Optional CA path or inline CA certificate when your provider supplies one.
DB_SSL_CA_PATH=
DB_SSL_CA=

# Optional bootstrap owner for an empty database
DEFAULT_BUSINESS_NAME=Zahlx Business
DEFAULT_BUSINESS_EMAIL=owner@zahlx.local

# Server
PORT=3001
